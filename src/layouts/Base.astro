---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-600.css';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';
import Gate from '../components/Gate.astro';
import Toolbar from '../components/Toolbar.astro';
import { book, gate, reading } from '../config';
import { passwordHash } from '../lib/sha256';

interface Props { title?: string; page: 'book' | 'timeline' | 'map' | 'gallery'; }
const { title, page } = Astro.props;
const fullTitle = title ? `${title} · ${book.title}` : book.title;
const gateOn = gate.enabled;
const hash = passwordHash(gate.answer);
const defaultTheme = reading.defaultTheme;
---
<!doctype html>
<html lang="en" data-theme={defaultTheme} class={gateOn ? 'locked' : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1f2a48" />
    <meta name="description" content="A private book." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{fullTitle}</title>
    <script is:inline define:vars={{ gateOn, hash, defaultTheme }}>
      (function () {
        var r = document.documentElement, t = null, ok = false;
        try { t = localStorage.getItem('pou:theme'); } catch (e) {}
        r.dataset.theme = t === 'night' || t === 'paper' ? t : defaultTheme;
        if (!gateOn) return;
        try { ok = localStorage.getItem('pou:key') === hash || sessionStorage.getItem('pou:key') === hash; } catch (e) {}
        if (ok) r.classList.remove('locked');
      })();
    </script>
  </head>
  <body>
    <Gate />
    <div class="site">
      <a class="skip-link" href="#main">Skip to the story</a>
      <Toolbar page={page} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <dialog class="lightbox" id="lightbox" aria-label="Photo">
      <button class="icon-btn lb-close" type="button" aria-label="Close photo" data-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <figure><img alt="" /><figcaption></figcaption></figure>
    </dialog>
    <script>
      import '../scripts/lightbox';
    </script>
  </body>
</html>
